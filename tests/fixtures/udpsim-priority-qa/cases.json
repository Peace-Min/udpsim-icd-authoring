    {
      "id": "multi-table",
      "kind": "positive",
      "input": "multi-table.pdf",
      "requested_pages": [
        2,
        4
      ],
      "request": "Define both messages inventoried on physical pages 2-4. The simulator is the controller. Follow page 1 dependencies.",
      "expected": {
        "schema_version": 1,
        "endian": "little",
        "unresolved": [],
        "types": [],
        "enums": [
          {
            "name": "Toggle",
            "items": [
              {
                "name": "Off",
                "value": 0
              },
              {
                "name": "On",
                "value": 1
              }
            ]
          }
        ],
        "header": [
          {
            "name": "Id",
            "type": "uint8",
            "role": "id"
          },
          {
            "name": "Size",
            "type": "uint8",
            "role": "length"
          },
          {
            "name": "Seq",
            "type": "uint8",
            "role": "seq",
            "max": 255,
            "scope": "link",
            "response": "count"
          }
        ],
        "messages": [
          {
            "direction": "receive",
            "code": "SENSOR_STATUS",
            "id": 145,
            "name": "Sensor status",
            "length": 6,
            "fields": [
              {
                "name": "Value",
                "type": "uint16"
              },
              {
                "name": "State",
                "type": "uint8",
                "enum": "Toggle"
              }
            ]
          },
          {
            "direction": "send",
            "code": "SET_LIMITS",
            "id": 146,
            "name": "Set limits",
            "length": 7,
            "fields": [
              {
                "name": "Limits",
                "type": "int16",
                "count": 2
              }
            ]
          }
        ]
      },
      "packet_checks": [
        {
          "packet_message": "SENSOR_STATUS",
          "payload_hex": "91 06 08 34 12 01",
          "expected_seq": 8,
          "expected_values": {
            "Value": "4660",
            "State": "On"
          }
        },
        {
          "packet_message": "SET_LIMITS",
          "payload_hex": "92 07 09 FE FF 2C 01",
          "expected_seq": 9,
          "expected_values": {
            "Limits[0]": "-2",
            "Limits[1]": "300"
          }
        }
      ]
    },
